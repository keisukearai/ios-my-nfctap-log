    "settings.uidNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التعرّف على البطاقات ذات المعرّف UID العشوائي. استخدم بطاقات مضادة للمعادن على الأسطح المعدنية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cards with randomized UIDs cannot be identified. Use anti-metal tags on metal surfaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden identificar las tarjetas con UID aleatorio. Usa etiquetas antimetal en superficies metálicas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलते (रैंडम) UID वाले कार्ड पहचाने नहीं जा सकते। धातु की सतह पर एंटी-मेटल टैग इस्तेमाल करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UID をランダム化するカードは識別できません。金属面にはアンチメタルタグを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别 UID 随机变化的卡片。金属面请使用抗金属标签。"
          }
        }
      }
    },
