    "tag.threshold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdue after"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経過の警告"
          }
        }
      }
    },
    "settings.thresholdNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once this much time passes, the elapsed time turns red on the home list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した時間を過ぎると、ホームの経過時間が赤くなります。"
          }
        }
      }
    },
    "tag.deleteNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tag and all of its history will be deleted. Re-registering the same tag does not restore it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグと履歴がすべて削除されます。同じタグを再登録しても履歴は戻りません。"
          }
        }
      }
    },
    "delete.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？"
          }
        }
      }
    },
    "settings.unnamedNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names are optional. Unnamed tags appear as “New tag”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前は任意です。付けていないタグは「新規タグ」として並びます。"
          }
        }
      }
    },
    "settings.registeredTags": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Registered tags"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録済みのタグ"
          }
        }
      }
    },
    "settings.registeredNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a tag to set its overdue warning, rename it, or delete it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグをタップすると、経過の警告・名前の変更・削除ができます。"
          }
        }
      }
    },
    "detail.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdue warning, rename and delete are handled in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経過の警告、名前の変更、タグの削除は設定画面で行います。"
          }
        }
      }
    },
    "settings.addTag": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a tag"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグの追加"
          }
        }
      }
    },
    "settings.scanToRegister": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan a tag to register"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグをスキャンして登録"
          }
        }
      }
    },
    "settings.addNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only registered tags appear on the home list. You can rename them later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "登録したタグだけがホームに並びます。名前は後から変更できます。"
          }
        }
      }
    },
    "rename.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を変更"
          }
        }
      }
    },
    "rename.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a name for this tag. Leave it empty to go back to “New tag”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグの名前を入力します。空のままにすると「新規タグ」に戻ります。"
          }
        }
      }
    },
    "rename.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. Take medicine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：薬を飲む"
          }
        }
      }
    },
    "scan.ok.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logged"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録しました"
          }
        }
      }
    },
    "scan.ok.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ — %2$@"
          }
        }
      }
    },
    "scan.ok.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That makes %lld entries."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これで %lld 件目です。"
          }
        }
      }
    },
    "scan.unknown.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unregistered tag"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未登録のタグです"
          }
        }
      }
    },
    "scan.unknown.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tag is not registered yet. Register it to start logging."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグはまだ登録されていません。登録すると記録を残せます。"
          }
        }
      }
    },
    "scan.unknown.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register this tag"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグを登録"
          }
        }
      }
    },
    "scan.fail.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the tag"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れませんでした"
          }
        }
      }
    },
    "scan.fail.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the top edge of your iPhone against the tag and keep still for a few seconds. Tags on metal need an anti-metal type."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone の上端をタグに近づけて、動かさずに数秒待ってください。金属面のタグはアンチメタル対応が必要です。"
          }
        }
      }
    },
    "scan.fail.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan again"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度スキャン"
          }
        }
      }
    },
    "scan.close": {
      "extractionState": "manual",
      "localizations": {
