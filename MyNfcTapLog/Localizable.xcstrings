          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経過の警告"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超时提醒"
          }
        }
      }
    },
    "settings.thresholdNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد مرور هذه المدة، يتحول الوقت المنقضي إلى اللون الأحمر في الشاشة الرئيسية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once this much time passes, the elapsed time turns red on the home list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando pase ese tiempo, el tiempo transcurrido se pondrá en rojo en la pantalla de inicio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तय समय बीत जाने पर होम सूची में बीता समय लाल हो जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した時間を過ぎると、ホームの経過時間が赤くなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过设定的时间后，主页上的经过时间会变成红色。"
          }
        }
      }
    },
    "tag.deleteNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف هذه البطاقة وكل سجلها. إعادة تسجيل البطاقة نفسها لا تستعيد السجل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tag and all of its history will be deleted. Re-registering the same tag does not restore it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán esta etiqueta y todo su historial. Volver a registrar la misma etiqueta no lo recupera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टैग और इसका पूरा इतिहास हट जाएगा। वही टैग दोबारा जोड़ने पर भी इतिहास वापस नहीं आता।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグと履歴がすべて削除されます。同じタグを再登録しても履歴は戻りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签及其全部历史记录都会被删除。重新登记同一标签也无法恢复历史记录。"
          }
        }
      }
    },
    "delete.confirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف «%@»؟"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@”?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar «%@»?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” को हटाएँ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要删除“%@”吗？"
          }
        }
      }
    },
    "settings.unnamedNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاسم اختياري. تظهر البطاقات بلا اسم باسم «بطاقة جديدة»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names are optional. Unnamed tags appear as “New tag”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre es opcional. Las etiquetas sin nombre aparecen como «Etiqueta nueva»."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम देना ज़रूरी नहीं है। बिना नाम वाले टैग “नया टैग” के रूप में दिखते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
