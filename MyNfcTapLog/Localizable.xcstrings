    "settings.addNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر البطاقات المسجّلة فقط في الشاشة الرئيسية. يمكنك إعادة تسميتها لاحقًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only registered tags appear on the home list. You can rename them later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las etiquetas registradas aparecen en la pantalla de inicio. Puedes cambiarles el nombre después."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "होम सूची में सिर्फ़ जोड़े गए टैग दिखते हैं। नाम बाद में बदला जा सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
