    "settings.registeredNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على بطاقة لضبط تنبيهها أو إعادة تسميتها أو حذفها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a tag to set its overdue warning, rename it, or delete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una etiqueta para configurar su aviso, cambiarle el nombre o eliminarla."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेतावनी का समय तय करने, नाम बदलने या हटाने के लिए टैग पर टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タグをタップすると、経過の警告・名前の変更・削除ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按标签即可设置超时提醒、重命名或删除。"
          }
        }
      }
    },
    "detail.footer": {
