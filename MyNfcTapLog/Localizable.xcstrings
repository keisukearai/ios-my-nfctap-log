    "scan.unknown.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه البطاقة غير مسجّلة بعد. سجّلها لتبدأ التدوين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This tag is not registered yet. Register it to start logging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etiqueta aún no está registrada. Regístrala para empezar a anotar."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह टैग अभी तक जोड़ा नहीं गया है। रिकॉर्ड रखने के लिए इसे जोड़ें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグはまだ登録されていません。登録すると記録を残せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标签尚未登记。登记后即可开始记录。"
          }
        }
      }
