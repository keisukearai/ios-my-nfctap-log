    "scan.fail.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة البطاقة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the tag"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la etiqueta"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैग नहीं पढ़ा जा सका"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取标签"
          }
        }
      }
    },
    "scan.fail.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قرّب الحافة العلوية من iPhone إلى البطاقة وأبقِه ثابتًا بضع ثوانٍ. البطاقات الموضوعة على المعدن تحتاج إلى نوع مضاد للمعادن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the top edge of your iPhone against the tag and keep still for a few seconds. Tags on metal need an anti-metal type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca el borde superior del iPhone a la etiqueta y mantenlo quieto unos segundos. Las etiquetas sobre metal deben ser de tipo antimetal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone के ऊपरी किनारे को टैग के पास ले जाएँ और कुछ सेकंड स्थिर रखें। धातु की सतह पर लगे टैग के लिए एंटी-मेटल टैग चाहिए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone の上端をタグに近づけて、動かさずに数秒待ってください。金属面のタグはアンチメタル対応が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 iPhone 顶端贴近标签，保持不动几秒钟。贴在金属面上的标签需要使用抗金属类型。"
          }
        }
      }
    },
    "scan.fail.cta": {
      "extractionState": "manual",
