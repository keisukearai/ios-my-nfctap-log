    "home.emptyBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ألصق بطاقة في المكان الذي يحدث فيه النشاط، ثم امسحها لتسجيلها. ستظهر البطاقات المسجّلة هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick a tag where the action happens, then scan it to register. Registered tags appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una etiqueta donde ocurra la acción y escanéala para registrarla. Las etiquetas registradas aparecerán aquí."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जहाँ वह काम होता है वहाँ टैग चिपकाएँ, फिर स्कैन करके जोड़ें। जोड़े गए टैग यहाँ दिखेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録したい行動の場所にタグを貼り、スキャンして登録します。登録したタグがここに並びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把标签贴在要记录的行为发生的地方，然后扫描登记。已登记的标签会显示在这里。"
          }
        }
      }
    },
    "home.emptyCta": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح بطاقة لتسجيلها"
          }
        },
        "en": {
          "stringUnit": {
