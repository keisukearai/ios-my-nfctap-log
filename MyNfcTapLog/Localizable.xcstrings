    "detail.noLogBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح هذه البطاقة وستظهر التواريخ هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this tag and the timestamps will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea esta etiqueta y las fechas aparecerán aquí."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टैग को स्कैन करने पर तारीख़ और समय यहाँ दिखेंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタグをスキャンすると、ここに日時が並びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描此标签后，时间会显示在这里。"
          }
        }
      }
    },
    "home.emptyTitle": {
