    "home.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البطاقات المدعومة: NTAG213 / NTAG215. استخدم بطاقات مضادة للمعادن على الأسطح المعدنية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supported tags: NTAG213 / NTAG215. Use anti-metal tags on metal surfaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiquetas compatibles: NTAG213 / NTAG215. Usa etiquetas antimetal en superficies metálicas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित टैग: NTAG213 / NTAG215। धातु की सतह पर एंटी-मेटल टैग इस्तेमाल करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応タグは NTAG213／NTAG215。金属面にはアンチメタルタグを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持的标签：NTAG213／NTAG215。金属面请使用抗金属标签。"
          }
        }
      }
    },
